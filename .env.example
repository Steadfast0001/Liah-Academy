# ============================================================================
# LIAH ACADEMY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' and set your real configuration values
# ============================================================================

# 1. Administrator Portal Credentials
# Set fresh unique values in production; never use these placeholders.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_bytes
STUDENT_SESSION_SECRET=replace_with_a_different_32_random_bytes
FILE_URL_SIGNING_SECRET=replace_with_another_32_random_bytes
# Optional: Path to store uploaded files outside public web root (defaults automatically to ../liah-private-uploads)
# PRIVATE_UPLOAD_DIR=/home/username/liah-private-uploads

# 2. MySQL Database Configuration (localhost / phpMyAdmin / cPanel)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name

# 3. Institutional Identity & Notification Defaults
INSTITUTION_NAME="Liah Academy of Technology and Management"
INSTITUTION_EMAIL=contact@example.com
INSTITUTION_PHONE="+237 000 000 000"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Institutional SMTP Email Server (Optional - logs locally if not configured)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASS=your_smtp_password_here

